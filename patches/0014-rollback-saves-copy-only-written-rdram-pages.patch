+    unsigned char* buffer;                    /* NULL: unused */
+    uint64_t tag;                             /* what the last save wrote into header[6..7] */
+    size_t len;                               /* the length of that save, header included */
+    uint64_t used;                            /* when it was last saved or loaded */
+    uint64_t stale[ROLLBACK_PAGE_WORDS];      /* RDRAM pages where the buffer may differ from RDRAM */
+};
