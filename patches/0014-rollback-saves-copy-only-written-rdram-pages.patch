+    }
+    if (rollback_verify && rollback_verify_shadow_valid && !all) {
+        /* every page that changed must have been noticed */
+        const unsigned char* now = (const unsigned char*)g_dev.rdram.dram;
+        for (i = 0; i < RDRAM_PAGE_COUNT; ++i) {
+            if ((written[i >> 6] >> (i & 63)) & 1)
+                continue;
+            if (memcmp(now + ((size_t)i << 12), rollback_verify_shadow + ((size_t)i << 12), 4096) != 0) {
+                if (rollback_stats[RB_STAT_VERIFY_UNNOTICED]++ < 8)
+                    DebugMessage(M64MSG_WARNING, "rollback verify: RDRAM page %04x changed without being noticed", i);
