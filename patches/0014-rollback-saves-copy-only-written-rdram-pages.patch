+/* Z-Cancel NX: the 4 KB pages of RDRAM written since the last rollback save or load, so that a save
+ * into a slot copies only the pages written since that slot was saved, and a load only the pages
+ * written since the state it restores (main/savestates.c). Everything that writes RDRAM marks the
+ * pages here: the CPU through the memory handler below or the recompiler's write traps
+ * (new_dynarec.c), the DMAs, the RSP plugin and the front end (ZnxRdramWritten), the code that
+ * restores a state. A writer that cannot say where it wrote sets rdram_written_all. */
+enum { RDRAM_PAGE_COUNT = 0x800 };   /* RDRAM_MAX_SIZE >> 12 */
+extern uint8_t rdram_written[RDRAM_PAGE_COUNT];
+extern int rdram_written_all;
+
+/* Plugins write RDRAM through their own pointer. One that reports what it writes (ZnxRdramWritten), or
+ * never writes, says so (ZnxRdramWriterReports); until then each of its calls counts as having written
+ * all of RDRAM. Reset when the plugin is attached or detached. */
+enum { RDRAM_WRITER_RSP, RDRAM_WRITER_VIDEO, RDRAM_WRITER_COUNT };
+extern int rdram_writer_reports[RDRAM_WRITER_COUNT];
+
+static osal_inline void rdram_plugin_call_done(int writer)
+{
+    if (!rdram_writer_reports[writer])
+        rdram_written_all = 1;
+}
+
+/* offset: a byte offset into RDRAM (a physical address) */
+static osal_inline void rdram_mark_written(uint32_t offset, uint32_t length)
+{
+    uint32_t page, last;
+    if (length == 0)
+        return;
+    if (offset >= (RDRAM_PAGE_COUNT << 12) || length > (RDRAM_PAGE_COUNT << 12) - offset) {
+        rdram_written_all = 1;
+        return;
+    }
+    last = (offset + length - 1) >> 12;
+    for (page = offset >> 12; page <= last; ++page)
+        rdram_written[page] = 1;
+}
+
 #endif
