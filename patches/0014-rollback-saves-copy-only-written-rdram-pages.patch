+static int rollback_page_count(const uint64_t* pages)
+{
+    int i, n = 0;
+    for (i = 0; i < ROLLBACK_PAGE_WORDS; ++i) {
+        uint64_t w = pages[i];
+        while (w) { w &= w - 1; ++n; }
+    }
+    return n;
+}
+
+/* Copies the pages of RDRAM set in pages (4 KB each; the state keeps RDRAM in host word order). */
+static void rollback_copy_pages(unsigned char* dst, const unsigned char* src, const uint64_t* pages)
+{
+    int i;
+    for (i = 0; i < ROLLBACK_PAGE_WORDS; ++i) {
+        uint64_t w = pages[i];
+        while (w) {
+            int first = __builtin_ctzll(w), run = 0;
+            /* a run of consecutive pages in one copy */
+            while (first + run < 64 && ((w >> (first + run)) & 1))
+                ++run;
+            memcpy(dst + ((size_t)(i * 64 + first) << 12), src + ((size_t)(i * 64 + first) << 12), (size_t)run << 12);
+            w &= run == 64 ? 0 : ~(((UINT64_C(1) << run) - 1) << first);
+        }
+    }
+}
+
+/* Ends the span since the last rollback save or load: the pages written in it may now differ in every
+ * slot. Called at the start of each rollback save or load into or from a buffer. */
+static void rollback_close_span(void)
+{
+    uint64_t written[ROLLBACK_PAGE_WORDS];
+    int i, j;
+    const int all = rdram_written_all || !rollback_rdram_tracked();
+
+    if (all)
+        memset(written, 0xff, sizeof(written));
+    else {
+        memset(written, 0, sizeof(written));
+        for (i = 0; i < RDRAM_PAGE_COUNT; ++i)
+            if (rdram_written[i])
