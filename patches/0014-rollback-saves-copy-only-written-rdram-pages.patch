+    }
+    for (j = 0; j < ROLLBACK_SLOT_MAX; ++j) {
+        if (rollback_slots[j].buffer == NULL)
+            continue;
+        for (i = 0; i < ROLLBACK_PAGE_WORDS; ++i)
+            rollback_slots[j].stale[i] |= written[i];
+    }
+    memset(rdram_written, 0, sizeof(rdram_written));
+    rdram_written_all = 0;
+}
+
+/* Starts the next span, once the save or load has done its own copying. */
+static void rollback_open_span(void)
+{
+#ifdef NEW_DYNAREC
+    if (g_dev.r4300.emumode == EMUMODE_DYNAREC)
+        new_dynarec_rdram_arm();
+#endif
+    if (rollback_verify) {
+        if (rollback_verify_shadow == NULL)
+            rollback_verify_shadow = malloc(RDRAM_MAX_SIZE);
+        if (rollback_verify_shadow != NULL) {
+            memcpy(rollback_verify_shadow, g_dev.rdram.dram, RDRAM_MAX_SIZE);
+            rollback_verify_shadow_valid = 1;
+        }
+    }
+}
