+    RB_STAT_VERIFY_SAVES, RB_STAT_VERIFY_LOADS, RB_STAT_VERIFY_DIFFER, RB_STAT_VERIFY_UNNOTICED,
+    RB_STAT_SAVE_PAGES_MOST, RB_STAT_LOAD_PAGES_MOST, RB_STAT_COUNT
