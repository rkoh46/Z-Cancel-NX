@@ -8710,10 +8715,39 @@
 #define DYNAMIC_CACHE_ADDR 2  // Put the dynarec cache at random address
 #define DOUBLE_CACHE_ADDR 3   // Put the dynarec cache at random address with RW address != RX address
 
+#if defined(__APPLE__)
+// macOS on Apple Silicon refuses memory that is writable and executable at once, and
+// shm_open memory cannot be mapped executable. Map the cache twice instead: an anonymous
+// read/write view, and a read/execute view of the same pages (mach_vm_remap) laid over
+// extra_memory. That keeps the executable view inside this library's image, where
+// generated code reaches the C helpers with direct branches (+/-128 MB) and the device
+// state with adrp, wherever the loader put the library.
+#define CACHE_ADDR DOUBLE_CACHE_ADDR
+  {
+    uintptr_t page = (uintptr_t)getpagesize();
+    mach_vm_address_t rx = ((uintptr_t)g_dev.r4300.extra_memory + page - 1) & ~(page - 1);
+    vm_prot_t cur_prot, max_prot;
+    kern_return_t kr;
+    assert(rx + (1<<TARGET_SIZE_2) <= (uintptr_t)g_dev.r4300.extra_memory + sizeof(g_dev.r4300.extra_memory));
+    base_addr = mmap(NULL, 1<<TARGET_SIZE_2, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    kr = base_addr==(void*)-1 ? KERN_FAILURE :
+         mach_vm_remap(mach_task_self(), &rx, 1<<TARGET_SIZE_2, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE,
+                       mach_task_self(), (mach_vm_address_t)(uintptr_t)base_addr, FALSE,
+                       &cur_prot, &max_prot, VM_INHERIT_NONE);
+    if(kr!=KERN_SUCCESS||mprotect((void*)(uintptr_t)rx, 1<<TARGET_SIZE_2, PROT_READ | PROT_EXEC)!=0) {
+      DebugMessage(M64MSG_ERROR, "new dynarec: could not map the code cache executable");
+      abort();
+    }
+    base_addr_rx = (void*)(uintptr_t)rx;
+  }
+#else
 // Default to fixed cache address
 #define CACHE_ADDR FIXED_CACHE_ADDR
+#endif
 
-#if CACHE_ADDR==DOUBLE_CACHE_ADDR
+#if defined(__APPLE__)
+#elif CACHE_ADDR==DOUBLE_CACHE_ADDR
   #include <unistd.h>
   #include <sys/types.h>
   #include <fcntl.h>
@@ -8818,7 +8852,14 @@
   #if defined(WIN32)
     VirtualFree(base_addr, 0, MEM_RELEASE);
   #elif NEW_DYNAREC == NEW_DYNAREC_ARM64 && CACHE_ADDR!=FIXED_CACHE_ADDR
+    #if defined(__APPLE__)
+    // Give extra_memory back as ordinary zeroed memory and drop the writable view.
+    if (mmap (base_addr_rx, 1<<TARGET_SIZE_2, PROT_READ | PROT_WRITE,
+              MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0) == (void*)-1) {DebugMessage(M64MSG_ERROR, "mmap() failed");}
+    if (munmap (base_addr, 1<<TARGET_SIZE_2) < 0) {DebugMessage(M64MSG_ERROR, "munmap() failed");}
+    #else
     if (munmap (base_addr_rx, 1<<TARGET_SIZE_2) < 0) {DebugMessage(M64MSG_ERROR, "munmap() failed");}
+    #endif
   #else
