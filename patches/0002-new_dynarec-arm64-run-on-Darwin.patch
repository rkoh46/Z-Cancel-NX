 #define HOST_REGS 29
 #define HOST_CCREG 20 /* callee-save */
 #define HOST_BTREG 19 /* callee-save */
+#if defined(__APPLE__)
+/* Darwin reserves x18: the kernel does not keep it across context switches.
+   The allocator never hands out EXCLUDE_REG (it is 29 elsewhere, which is past
+   HOST_REGS and so excludes nothing), and trampolines go through x17. */
+#define EXCLUDE_REG 18
+#define TRAMPOLINE_REG 17
+#else
 #define EXCLUDE_REG 29 /* FP */
+#define TRAMPOLINE_REG 18
+#endif
 
