+CORE_EXPORT long long rmgk_gekko::last_present_sleep_us(unsigned long long* calls)
+{
+#ifdef RMGK_HAVE_GEKKONET
+    if (calls != nullptr)
+    {
+        *calls = g_RollbackPresentCalls.load(std::memory_order_relaxed);
+    }
+    return g_RollbackPresentLastSleepUs.load(std::memory_order_relaxed);
+#else
+    if (calls != nullptr)
+    {
+        *calls = 0;
+    }
+    return 0;
+#endif
+}
