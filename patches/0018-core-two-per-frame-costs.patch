Core: two per-frame costs with no effect on emulated state

- pif.c asked getenv("RMGK_VERBOSE_PIF_INPUT_LOGGING") for every controller channel of every frame
  (rollback_log_pif_channel); it is read once now.
- cart_rom_dma_write copied ROM to RDRAM a byte at a time through the byte swizzle; when both
  addresses are word aligned and the copy ends inside RDRAM the whole words are one memcpy (the
  swizzle stays inside each word), the remaining bytes as before.

--- a/mupen64plus-core/src/device/cart/cart_rom.c
+++ b/mupen64plus-core/src/device/cart/cart_rom.c
@@ -32,6 +32,7 @@
 
 #define __STDC_FORMAT_MACROS
 #include <inttypes.h>
+#include <string.h>
 
 #define CART_ROM_ADDR_MASK UINT32_C(0xefffffff);
 
@@ -106,7 +107,14 @@
 
     if (cart_addr + length < cart_rom->rom_size)
     {
-        for(i = 0; i < length && (dram_addr+i) < cart_rom->r4300->rdram->dram_size; ++i) {
+        i = 0;
+        /* Z-Cancel NX: whole words at once when both sides are word aligned (the byte swizzle S8 stays
+         * inside each word then) and the copy ends inside RDRAM; the loop below does the rest */
+        if (((dram_addr | cart_addr) & 3) == 0 && (uint64_t)dram_addr + length <= cart_rom->r4300->rdram->dram_size) {
+            i = length & ~(uint32_t)3;
+            memcpy(dram + dram_addr, mem + cart_addr, i);
+        }
+        for(; i < length && (dram_addr+i) < cart_rom->r4300->rdram->dram_size; ++i) {
             dram[(dram_addr+i)^S8] = mem[(cart_addr+i)^S8];
         }
     }
--- a/mupen64plus-core/src/device/pif/pif.c
+++ b/mupen64plus-core/src/device/pif/pif.c
@@ -133,8 +133,13 @@
 
 static int rollback_verbose_pif_input_logging_enabled(void)
 {
-    const char* value = getenv("RMGK_VERBOSE_PIF_INPUT_LOGGING");
-    return value != NULL && value[0] == '1';
+    /* Z-Cancel NX: read once; this is asked for every controller channel of every frame */
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("RMGK_VERBOSE_PIF_INPUT_LOGGING");
+        enabled = value != NULL && value[0] == '1';
+    }
+    return enabled;
 }
 
 static const char* rollback_log_path_separator(const char* directory)
