@@ -8741,12 +8748,22 @@
     }
     base_addr_rx = (void*)(uintptr_t)rx;
   }
+#elif defined(__SWITCH__)
+// Nintendo Switch (Horizon): the executable view is the jit_memory array in .text, so the
+// generated code sits inside the program image like extra_memory does elsewhere (direct
+// branches to the C helpers, adrp to the device state, wherever the NRO was loaded); the
+// writable view is a second mapping of the same pages (svcMapProcessMemory).
+#define CACHE_ADDR DOUBLE_CACHE_ADDR
+  if(!znx_jit_map(1<<TARGET_SIZE_2, &base_addr, &base_addr_rx)) {
+    DebugMessage(M64MSG_ERROR, "new dynarec: could not map the code cache writable");
