new_dynarec arm64: link exits taken by a conditional branch

On ARM64 the recompiler linked a block's exit to the block it jumps to only when the exit was an
unconditional b; an exit taken by a b.cond (reach +/- 1 MB, the code cache is 32 MB) stayed on its
stub, so every time it was taken the code called dyna_linker -> dynamic_linker, which looked the
target up again in the jump_in list of its page. In steady play that was 8 to 15 % of the emulation
thread on the Mac (dynamic_linker alone), and the same on every frame re-run after a rollback.

The stub of such an exit now starts with one extra word, a nop while the exit is unlinked and
"b target" once it is linked (b reaches 128 MB). The b.cond keeps jumping to its stub. Linking writes
that word (at compile time in pass 9, when a shadow compiled ahead is adopted, and in
dynamic_linker/dynamic_linker_ds), and the jump_out entry names the stub, so kill_pointer (back to the
nop) and get_pointer (the b's target) undo and read it like any other link. warm_same_code skips the
word, as it skips linked jumps. Host control flow only: the block run next is the one the linker
would have returned, with the same cycle count; x86-64 already linked these exits.

--- a/mupen64plus-core/src/device/r4300/new_dynarec/arm64/assem_arm64.c
+++ b/mupen64plus-core/src/device/r4300/new_dynarec/arm64/assem_arm64.c
@@ -364,10 +364,42 @@
   intptr_t ptr_rx=((intptr_t)ptr-(intptr_t)base_addr)+(intptr_t)base_addr_rx;
   cache_flush((void*)ptr_rx, (void*)(ptr_rx+4));
   return ptr2;
+}
+
+/* Z-Cancel NX: exits taken by a conditional branch (b.cond reaches only +/- 1 MB) are linked
+ * through their stub instead of being left to call the linker every time. Such a stub starts
+ * with one extra word: a nop while the exit is unlinked, "b target" once it is linked (b reaches
+ * +/- 128 MB, the whole code cache). The b.cond itself always jumps to the stub. The linked word
+ * is recognised by not being the movz an ordinary stub starts with. */
+#define COND_STUB_NOP 0xd503201fu
+static int is_cond_stub(const void *stub)
+{
+  const u_int w=*(const u_int *)stub;
+  return w==COND_STUB_NOP||(w&0xFC000000)==0x14000000;
+}
+
+/* src: a b.cond (write view) whose stub has the extra word; links it to addr (write view).
+ * Returns the stub, or NULL when src is not such a branch. Does not flush the cache. */
+static void *link_cond_stub(void *src, void *addr)
+{
+  u_int *ptr=(u_int *)src;
+  u_int *stub;
+  intptr_t offset;
+  if((*ptr&0xff000010)!=0x54000000) return NULL;
+  stub=(u_int *)((intptr_t)ptr+(((intptr_t)(int)(*ptr<<8))>>13<<2));
+  if(!is_cond_stub(stub)) return NULL;
+  offset=(intptr_t)addr-(intptr_t)stub;
+  assert(offset>=-134217728LL&&offset<134217728LL);
+  *stub=0x14000000|((offset>>2)&0x3ffffff);
+  return stub;
 }
 
 static void *kill_pointer(void *stub)
 {
+  if(is_cond_stub(stub)) {
+    *(u_int *)stub=COND_STUB_NOP;
+    return stub;
+  }
   int *ptr=(int *)((intptr_t)stub+8);
   assert((*ptr&0x9f000000)==0x10000000); //adr
   int offset=(((signed int)(*ptr<<8)>>13)<<2)|((*ptr>>29)&0x3);
@@ -379,6 +411,11 @@
 
 static intptr_t get_pointer(void *stub)
 {
+  if(is_cond_stub(stub)) {
+    const u_int w=*(const u_int *)stub;
+    if(w==COND_STUB_NOP) return (intptr_t)stub;
+    return (intptr_t)stub+(((intptr_t)(int)(w<<6))>>4);
+  }
   int *ptr=(int *)((intptr_t)stub+8);
   assert((*ptr&0x9f000000)==0x10000000); //adr
   int offset=(((signed int)(*ptr<<8)>>13)<<2)|((*ptr>>29)&0x3);
@@ -3147,6 +3184,7 @@
   u_char *ptr=(u_char *)addr;
 #endif
   assert(((ptr[3]&0xfc)==0x14)||((ptr[3]&0xff)==0x54)); //b or b.cond
+  if((*(u_int *)addr&0xff000010)==0x54000000) output_w32(COND_STUB_NOP); // see link_cond_stub
 
   emit_movz_lsl16(((u_int)target>>16)&0xffff,1);
   emit_movk((u_int)target&0xffff,1);
