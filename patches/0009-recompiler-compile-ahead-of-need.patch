+
+/**** Z-Cancel NX: warm list (compile ahead of need) ****/
+// The only frames that miss 16.7 ms on a Switch are the ones that compile blocks for the first
+// time (about 0.5 ms a block on a Cortex-A57). So: every compile is recorded as (address, source
+// length, checksum of the source words); the front end keeps that list per ROM and loads it at
+// the next start; and in the idle time after a frame new_dynarec_warm_precompile() compiles the
+// listed blocks whose source is in RAM right now, before the game asks for them.
+//
+// A block compiled ahead is a "shadow". It is generated by the same passes at `out`, where the
+// next block would go, but then its code is copied away as plain data and `out` is put back:
+// the code cache, jump_in, jump_dirty, jump_out, the hash table, the write protection of pages,
+// the expiry pointer, and so everything the running game can reach, are exactly as before the
+// call (the bytes past `out` are free space, which the next compile overwrites anyway).
+// When the game asks for a block, new_recompile_block() runs its first pass as always, so the
+// block's extent is decided as without a list: by what is compiled at that moment. If a shadow
+// with that address, that length and those source words exists, its code is copied to `out`
+// with its references to places outside the block adjusted (warm_relocate), and the compile goes
+// on from its linker pass: exits linked to what exists now, entry points entered, the cache
+// flushed, the pages protected, old blocks expired. The code cache then holds what a full compile
+// at that moment would have put there, at the same place; passes 2 to 8 are the same function of
+// the same input. So a run with a list goes through the same blocks, of the same shape, at the
+// same cache positions as a run without one, for as long as it lasts, and nothing the guest can
+// observe differs. See the patch description for the argument in full.
+#define WARM_PAGES 2048               // RDRAM pages; only kseg0 RDRAM blocks are compiled ahead
+#define WARM_SHADOW_BINS 4096
+#define WARM_SHADOW_LIMIT (64u<<20)   // bytes of shadow code kept at most
+
+struct warm_entry
+{
+  u_int addr;     // as passed to new_recompile_block (bit 0: starts in a delay slot)
+  u_int len;      // source bytes
+  u_int sum;      // warm_sum() of the source words
+  int page_next;  // next entry starting in the same page (index+1, 0 = end)
+  u_char done;    // compiled (on demand or ahead) in this session: not pending
+};
+
+struct warm_link { u_int jump; u_int stub; u_int target; u_int linkable; }; // jump, stub: offsets in the code
+struct warm_node { struct ll_entry *dirty; struct ll_entry *in; u_int page; u_int vpage; u_int hash; };
+struct warm_shadow
+{
+  struct warm_shadow *next;
+  u_int addr;
+  u_int slen;
+  u_int tlb;            // using_tlb when it was compiled (changes the code of loads and stores)
+  u_int sets_saj;       // the compile set stop_after_jal (delayslot_alloc)
+  char *copy;           // the source it was compiled from, as every block keeps it
+  u_char *code;         // the generated code, as data
+  u_char *origin;       // where in the cache it was generated: as it is, it would run there
+  u_int size, lit;      // bytes of code; where its literal pool starts
+  struct warm_link *links;
+  struct warm_node *nodes;
+  int nlinks, nnodes;
+};
+
+static struct warm_entry *warm_list;
+static int warm_cap;
+static int *warm_set;                 // open addressing, index+1
+static u_int warm_set_size;
+static int warm_page_head[WARM_PAGES];
+static u_char warm_page_span[WARM_PAGES];   // pages the longest entry of this page reaches past it
+static u_char warm_page_dirty[WARM_PAGES];
+static u_short warm_queue[WARM_PAGES];
+static u_int warm_q_head, warm_q_count;
+static int warm_cursor;               // where in the page at the head of the queue to go on (index+1)
+static int warm_cursor_waiting;       //   and whether that page has a block waiting for a call with more time
+static u_int warm_rotate;
+static struct warm_shadow *warm_shadows[WARM_SHADOW_BINS];
+static int warm_shadow_count;
+static size_t warm_shadow_bytes;
+static int warm_pending;              // entries that could be compiled ahead and are not done
+static int warm_active;               // between new_dynarec_init and new_dynarec_cleanup
+static int warm_flags;                // 1: verify (compile anyway and compare with the shadow), 2: hash the generated code
+static double warm_us_per_word = 8.0; // running cost of a compile, to stay inside the budget
+// What new_recompile_block's body is doing: 0 a compile on demand, else the forced length of a shadow.
+static u_int warm_shadow_slen;
+static struct
+{
+  uint64_t loaded, shadows, shadow_failed, adopted, full, full_known, precompile_us, tests, calls, oversized;
+  uint64_t verify_bad, verified, code_bytes, code_hash, size_hash, analysis_hash, adopt_us;
+} warm_stats;
+
+static u_int warm_sum(const u_int *words, u_int count)
+{
+  u_int h=0x811c9dc5u^count, i;
+  for(i=0;i<count;i++) { h=(h^words[i])*0x9e3779b1u; h^=h>>15; }
+  return h;
+}
+
+static int warm_can_precompile(u_int addr, u_int len)
+{
+#if NEW_DYNAREC == NEW_DYNAREC_ARM64
+  return addr>=0x80000000u&&addr<0x80800000u&&(addr&3)==0&&len>=4&&(len&3)==0&&
+         len<=(MAXBLOCK-2)*4&&addr+len<=0x80800000u-8;
+#else
+  (void)addr; (void)len;
+  return 0; // moving generated code is written for ARM64 only (warm_relocate)
+#endif
+}
+
+static void warm_set_done(struct warm_entry *e)
+{
+  if(!e->done) {
+    e->done=1;
+    if(warm_can_precompile(e->addr,e->len)) warm_pending--;
+  }
+}
+
+static u_int warm_slot(u_int addr, u_int len, u_int sum)
+{
+  u_int h=(addr*0x9e3779b1u)^(len*0x85ebca6bu)^sum;
+  return (h^(h>>16))&(warm_set_size-1);
+}
+
+static void warm_set_grow(void)
+{
+  u_int size=warm_set_size?warm_set_size*2:4096;
+  int *table=(int *)calloc(size,sizeof(int));
+  int i;
+  assert(table!=NULL);
+  free(warm_set);
+  warm_set=table;
+  warm_set_size=size;
+  for(i=0;i<warm_count;i++) {
+    u_int s=warm_slot(warm_list[i].addr,warm_list[i].len,warm_list[i].sum);
+    while(warm_set[s]) s=(s+1)&(warm_set_size-1);
+    warm_set[s]=i+1;
+  }
+}
+
+// The entry's index, or -1.
+static int warm_find(u_int addr, u_int len, u_int sum)
+{
+  u_int s;
+  if(!warm_set_size) return -1;
+  s=warm_slot(addr,len,sum);
+  while(warm_set[s]) {
+    const struct warm_entry *e=&warm_list[warm_set[s]-1];
+    if(e->addr==addr&&e->len==len&&e->sum==sum) return warm_set[s]-1;
+    s=(s+1)&(warm_set_size-1);
+  }
+  return -1;
+}
+
+// Adds the entry if it is new. Returns its index; *known says whether it was there already.
+static int warm_add(u_int addr, u_int len, u_int sum, int *known)
+{
+  int index=warm_find(addr,len,sum);
+  struct warm_entry *e;
+  u_int s;
+  if(known) *known=index>=0;
+  if(index>=0) return index;
+  if(warm_count==warm_cap) {
+    warm_cap=warm_cap?warm_cap*2:4096;
+    warm_list=(struct warm_entry *)realloc(warm_list,warm_cap*sizeof(struct warm_entry));
+    assert(warm_list!=NULL);
+  }
+  if((u_int)(warm_count+1)*2>warm_set_size) warm_set_grow();
+  index=warm_count++;
+  e=&warm_list[index];
+  e->addr=addr; e->len=len; e->sum=sum; e->page_next=0; e->done=0;
+  s=warm_slot(addr,len,sum);
+  while(warm_set[s]) s=(s+1)&(warm_set_size-1);
+  warm_set[s]=index+1;
+  if(warm_can_precompile(addr,len)) {
+    u_int page=(addr-0x80000000u)>>12;
+    u_int span=((addr+len-4-0x80000000u)>>12)-page;
+    e->page_next=warm_page_head[page];
+    warm_page_head[page]=index+1;
+    if(span>warm_page_span[page]) warm_page_span[page]=span;
+    warm_pending++;
+  }
+  return index;
+}
+
+static void warm_mark_page(u_int page)
+{
+  if(page<WARM_PAGES&&warm_page_head[page]&&!warm_page_dirty[page]) {
+    warm_page_dirty[page]=1;
+    warm_queue[(warm_q_head+warm_q_count)%WARM_PAGES]=page;
+    warm_q_count++;
+  }
+}
+
+// RDRAM pages first..last may hold new code: their pending entries are tested again, and so are
+// those of the pages before whose blocks reach into them.
+static void warm_mark_range(u_int first, u_int last)
+{
+  u_int k,page;
+  if(!warm_pending) return;
+  if(last>=WARM_PAGES) last=WARM_PAGES-1;
+  for(k=1;k<=4&&k<=first;k++)
+    if(warm_page_span[first-k]>=k) warm_mark_page(first-k);
+  for(page=first;page<=last;page++) warm_mark_page(page);
+}
+
+static void warm_mark_all(void)
+{
+  warm_mark_range(0,WARM_PAGES-1);
+}
+
+static void warm_shadow_free(struct warm_shadow *s, int adopted)
+{
+  if(!adopted) {
+    // Never entered anywhere: the list nodes and the source copy are still this shadow's own.
+    int n;
+    for(n=0;n<s->nnodes;n++) { free(s->nodes[n].dirty); free(s->nodes[n].in); }
+    free(s->copy);
+    copy_size-=s->slen*4+4;
+  }
+  warm_shadow_bytes-=s->size;
+  free(s->code);
+  free(s->links);
+  free(s->nodes);
+  free(s);
+  warm_shadow_count--;
+}
+
+static void warm_drop_shadows(void)
+{
+  int bin;
+  for(bin=0;bin<WARM_SHADOW_BINS;bin++) {
+    struct warm_shadow *s=warm_shadows[bin];
+    warm_shadows[bin]=NULL;
+    while(s) {
+      struct warm_shadow *next=s->next;
+      warm_shadow_free(s,0);
+      s=next;
+    }
+  }
+  assert(warm_shadow_count==0);
+}
+
+// The shadow for a block that pass 1 of a compile on demand has just measured, taken out of the table.
+static struct warm_shadow *warm_shadow_take(u_int addr, u_int slen, const u_int *words)
+{
+  struct warm_shadow **cur=&warm_shadows[((addr>>2)^(addr>>14))&(WARM_SHADOW_BINS-1)];
+  while(*cur) {
+    struct warm_shadow *s=*cur;
+    if(s->addr==addr&&s->slen==slen&&s->tlb==using_tlb&&!memcmp(s->copy,words,slen*4)) {
+      *cur=s->next;
+      return s;
+    }
+    cur=&s->next;
+  }
+  return NULL;
+}
+
+static int warm_shadow_exists(u_int addr, u_int slen, const u_int *words)
+{
+  const struct warm_shadow *s=warm_shadows[((addr>>2)^(addr>>14))&(WARM_SHADOW_BINS-1)];
+  for(;s;s=s->next)
+    if(s->addr==addr&&s->slen==slen&&s->tlb==using_tlb&&!memcmp(s->copy,words,slen*4)) return 1;
+  return 0;
+}
+
+// Writes a shadow's code into buffer as it would have been generated at cache address `at`.
+// Generated code refers to itself with pc-relative instructions, which need no change, and to
+// places outside the block (the C helpers, the list nodes its dirty stubs name) pc-relatively
+// too, which do: every A64 pc-relative instruction whose target lies outside the block is
+// re-encoded for the new place. The literal pool at the end is data (absolute addresses).
+// Returns 0 when a target is out of the instruction's reach from there (not adopted then).
+static int warm_relocate(const struct warm_shadow *s, u_char *buffer, const u_char *at)
+{
+#if NEW_DYNAREC == NEW_DYNAREC_ARM64
+  const intptr_t delta=(intptr_t)at-(intptr_t)s->origin;
+  const u_int *src=(const u_int *)s->code;
+  u_int *dst=(u_int *)buffer;
+  const u_int words=s->lit>>2;
+  u_int i;
+  memcpy(buffer,s->code,s->size);
+  if(!delta) return 1;
+  for(i=0;i<words;i++) {
+    const u_int w=src[i];
+    const intptr_t pc=(intptr_t)s->origin+i*4;
+    intptr_t offset,limit;
+    int kind;
+    if((w&0x7c000000)==0x14000000) { offset=((intptr_t)(int)(w<<6))>>4; limit=134217728; kind=0; }   // b, bl
+    else if((w&0xff000010)==0x54000000||(w&0x7e000000)==0x34000000||(w&0x3b000000)==0x18000000) {
+      offset=((intptr_t)(int)(w<<8))>>11; limit=1048576; kind=1;                                       // b.cond, cbz, cbnz, ldr literal
+    }
+    else if((w&0x7e000000)==0x36000000) { offset=((intptr_t)(int)(w<<13))>>16; limit=32768; kind=2; }  // tbz, tbnz
+    else if((w&0x9f000000)==0x10000000) { offset=(((intptr_t)(int)(w<<8))>>11)|((w>>29)&3); limit=1048576; kind=3; } // adr
+    else if((w&0x9f000000)==0x90000000) {                                                               // adrp
+      // pages of the executable view, as emit_adrp counts them
+      const intptr_t rx=pc-(intptr_t)base_addr+(intptr_t)base_addr_rx;
+      const intptr_t page=(rx&~(intptr_t)0xfff)+(((((intptr_t)(int)(w<<8))>>11)|((w>>29)&3))<<12);
+      offset=(page-((rx+delta)&~(intptr_t)0xfff))>>12;
+      if(offset<-1048576||offset>=1048576) return 0;
+      dst[i]=(w&0x9f00001f)|((u_int)offset&3)<<29|(((u_int)(offset>>2))&0x7ffff)<<5;
+      continue;
+    }
+    else continue;
+    if(pc+offset>=(intptr_t)s->origin&&pc+offset<(intptr_t)s->origin+(intptr_t)s->size) continue; // inside the block
+    offset-=delta;
+    if(offset<-limit||offset>=limit) return 0;
+    if(kind==0) dst[i]=(w&0xfc000000)|(((u_int)(offset>>2))&0x3ffffff);
+    else if(kind==1) dst[i]=(w&0xff00001f)|(((u_int)(offset>>2))&0x7ffff)<<5;
+    else if(kind==2) dst[i]=(w&0xfff8001f)|(((u_int)(offset>>2))&0x3fff)<<5;
+    else dst[i]=(w&0x9f00001f)|((u_int)offset&3)<<29|(((u_int)(offset>>2))&0x7ffff)<<5;
