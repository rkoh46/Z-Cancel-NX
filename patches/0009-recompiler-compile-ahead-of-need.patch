+static uint64_t recompile_now_us(void);
+static int recompile_block_body(int addr);
+
+// A compile on demand has finished in full (1) or by adopting a shadow (0).
+static void warm_note_demand(u_int addr, u_int slen, const u_int *words, int full)
+{
+  int known=0;
+  int index=warm_add(addr,slen*4,warm_sum(words,slen),&known);
+  int missed=known&&!warm_list[index].done;
+  warm_set_done(&warm_list[index]);
+  if(full) {
+    warm_stats.full++;
+    if(known) warm_stats.full_known++;
+    if(addr>=0x80000000u&&addr<0x80800000u) {
+      // Code this session had not seen is being run. If the list knew the block, a whole piece of
+      // game code has arrived without a DMA telling (copied by the CPU): look at every page again.
+      if(missed) warm_mark_all();
+      else warm_mark_range((addr-0x80000000u)>>12,(addr+slen*4-4-0x80000000u)>>12);
+    }
+  }
+  else warm_stats.adopted++;
+  if((uintptr_t)out-(uintptr_t)base_addr>warm_stats.code_bytes) warm_stats.code_bytes=(uintptr_t)out-(uintptr_t)base_addr;
+}
+
+void new_dynarec_warm_reset(void)
+{
+  free(warm_list); warm_list=NULL; warm_count=warm_cap=0;
+  free(warm_set); warm_set=NULL; warm_set_size=0;
+  memset(warm_page_head,0,sizeof(warm_page_head));
+  memset(warm_page_span,0,sizeof(warm_page_span));
+  memset(warm_page_dirty,0,sizeof(warm_page_dirty));
+  warm_q_head=warm_q_count=0;
+  warm_cursor=0;
+  warm_pending=0;
+  memset(&warm_stats,0,sizeof(warm_stats));
+}
+
+// Entries are three words: address, length in bytes, checksum. Returns how many were new.
+int new_dynarec_warm_load(const unsigned int *entries, int count)
+{
+  int i,added=0;
+  for(i=0;i<count;i++) {
+    int known;
+    u_int addr=entries[i*3],len=entries[i*3+1];
+    if(len<4||(len&3)||len>MAXBLOCK*4) continue;
+    warm_add(addr,len,entries[i*3+2],&known);
+    if(!known) added++;
+  }
+  warm_stats.loaded+=added;
+  if(warm_active) warm_mark_all();
+  return added;
+}
+
+// Copies up to max entries out; returns how many there are.
+int new_dynarec_warm_read(unsigned int *entries, int max)
+{
+  int i;
+  for(i=0;i<warm_count&&i<max;i++) {
+    entries[i*3]=warm_list[i].addr;
+    entries[i*3+1]=warm_list[i].len;
+    entries[i*3+2]=warm_list[i].sum;
+  }
+  return warm_count;
+}
