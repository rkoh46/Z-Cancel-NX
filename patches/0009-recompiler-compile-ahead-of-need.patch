+void new_dynarec_warm_config(int flags)
+{
+  warm_flags=flags;
+}
+
+void new_dynarec_warm_stats(unsigned long long *stats)
+{
+  stats[0]=warm_stats.loaded;        // entries given to new_dynarec_warm_load
+  stats[1]=(unsigned long long)warm_count;   // entries now (loaded and recorded)
+  stats[2]=warm_stats.shadows;       // blocks compiled ahead
+  stats[3]=warm_stats.adopted;       // of those, asked for by the game since
+  stats[4]=warm_stats.full;          // blocks compiled in full when the game asked
+  stats[5]=warm_stats.full_known;    //   of those, blocks the list had
+  stats[6]=warm_stats.precompile_us; // time inside new_dynarec_warm_precompile
+  stats[7]=warm_stats.oversized;     // blocks compiled ahead that took longer than a budget (oversized_us)
+  stats[8]=(unsigned long long)warm_pending;   // entries that could be compiled ahead and were not in this session
+  stats[9]=warm_stats.code_bytes;    // code cache used (until it wraps)
+  stats[10]=(unsigned long long)warm_shadow_bytes; // shadow code waiting to be asked for
+  stats[11]=warm_stats.verify_bad;   // verify mode: shadows that differed from the compile
+  stats[12]=warm_stats.code_hash;    // flag 2: FNV-1a of every block entered in the cache, in order, without its literals
+  stats[13]=warm_stats.size_hash;    //   and of their sizes
+  stats[14]=warm_stats.verified;     // verify mode: shadows compared
+  stats[15]=warm_stats.analysis_hash; //   and of what passes 1 to 7 decided for every block compiled in full
+}
+
+// Compiles pending entries whose source is in RAM now, for at most budget_us microseconds: a
+// block is only started when the time it should take is left. A block that should take longer
+// than the whole budget (the largest are thousands of instructions) waits, its page staying
+// marked, for a call with more: a larger budget, or oversized_us, the time the caller is ready to
+// give to one such block compiled alone in a call (0: none). The caller chooses that when a late
+// frame costs least: the code has just been loaded, rather than when the game first runs it.
+// To be called on the emulation thread, between two blocks of the game: after a frame. Returns
+// the number of blocks compiled.
+int new_dynarec_warm_precompile(unsigned int budget_us, unsigned int oversized_us)
+{
+  uint64_t begin,now;
+  int compiled=0,since_clock=0;
+  u_int pages;
+  if(!budget_us||!warm_pending||!warm_active||warm_shadow_slen) return 0;
+  warm_stats.calls++;
+  {
+    // One page a call is looked at whatever else is known, in turn, for code that arrived without
+    // any of the events that mark a page.
+    u_int k;
+    for(k=0;k<WARM_PAGES&&!warm_page_head[warm_rotate];k++) warm_rotate=(warm_rotate+1)%WARM_PAGES;
+    warm_mark_page(warm_rotate);
+    warm_rotate=(warm_rotate+1)%WARM_PAGES;
+    if(!warm_q_count) return 0;
+  }
+  begin=now=recompile_now_us();
+  for(pages=warm_q_count;pages>0&&warm_q_count;pages--) { // each marked page once a call
+    u_int page=warm_queue[warm_q_head];
+    int index=warm_cursor?warm_cursor:warm_page_head[page];
+    int waiting=warm_cursor?warm_cursor_waiting:0;
+    warm_cursor=0;
+    while(index) {
+      struct warm_entry *e=&warm_list[index-1];
+      int next=e->page_next;
+      if(!e->done) {
+        const u_int *words=(const u_int *)((uintptr_t)g_dev.rdram.dram+(e->addr-0x80000000u));
+        u_int count=e->len>>2;
+        warm_stats.tests++;
+        if(++since_clock>=16) { since_clock=0; now=recompile_now_us(); }
+        if(now-begin>=budget_us) { warm_cursor=index; warm_cursor_waiting=waiting; goto done; }
+        if(warm_sum(words,count)==e->sum) {
+          const uint64_t before=now=recompile_now_us();
+          const double estimate=warm_us_per_word*count;
+          int oversized=0;
+          if(warm_shadow_bytes>=WARM_SHADOW_LIMIT) { warm_cursor=index; warm_cursor_waiting=waiting; goto done; }
+          if(estimate>(double)budget_us) {
+            // It fits in no call with this budget: alone and first in a call that allows it, or later.
+            if(estimate>(double)oversized_us||compiled||(before-begin)*4>=budget_us) { waiting=1; index=next; continue; }
+            oversized=1;
+          }
+          else if((double)(before-begin)+estimate*1.5>(double)budget_us&&(before-begin)*4>=budget_us) {
+            // Not enough of this call's time is left. (A call that has used under a quarter of its
+            // budget goes ahead: the next call would not have more for this block.)
+            warm_cursor=index;
+            warm_cursor_waiting=waiting;
+            goto done;
+          }
+          warm_set_done(e);
+          if(!warm_shadow_exists(e->addr,count,words)) {
+            warm_shadow_slen=count;
+            if(recompile_block_body((int)e->addr)==0) { warm_stats.shadows++; compiled++; warm_stats.oversized+=oversized; }
+            else warm_stats.shadow_failed++;
+            warm_shadow_slen=0;
+            now=recompile_now_us();
+            warm_us_per_word=warm_us_per_word*0.9+0.1*((double)(now-before)/count);
+          }
+          if(oversized) budget_us=1; // nothing more in this call
+        }
+      }
+      index=next;
+    }
+    warm_q_head=(warm_q_head+1)%WARM_PAGES;
+    if(waiting) warm_queue[(warm_q_head+warm_q_count-1)%WARM_PAGES]=page; // to the back, still marked
+    else { warm_page_dirty[page]=0; warm_q_count--; }
+  }
+done:
+  warm_stats.precompile_us+=recompile_now_us()-begin;
+  return compiled;
 }
 
+// A session starts: nothing is compiled, every entry is pending again.
+static void warm_session_begin(void)
+{
+  int i;
+  uint64_t loaded=warm_stats.loaded;
+  warm_pending=0;
+  for(i=0;i<warm_count;i++) {
+    warm_list[i].done=0;
+    if(warm_can_precompile(warm_list[i].addr,warm_list[i].len)) warm_pending++;
+  }
+  memset(warm_page_dirty,0,sizeof(warm_page_dirty));
+  warm_q_head=warm_q_count=0;
+  warm_cursor=warm_cursor_waiting=0;
+  warm_rotate=0;
+  warm_shadow_slen=0;
+  warm_us_per_word=8.0;
+  memset(&warm_stats,0,sizeof(warm_stats));
+  warm_stats.loaded=loaded;
+  warm_active=1;
+}
+
+static void warm_session_end(void)
+{
+  warm_drop_shadows();
+  warm_active=0;
+}
