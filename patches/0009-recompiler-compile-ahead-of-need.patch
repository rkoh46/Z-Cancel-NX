+// Verify mode: is the shadow, moved to `begin`, the code the full compile has just put there?
+// Every instruction must be equal except the exits (the compile linked those it could, a
+// shadow's go to their stubs until it is adopted). The literal pool holds the addresses of the
+// list nodes, which are each compile's own; its size must be equal.
+static int warm_same_code(const struct warm_shadow *s, const u_char *begin, const u_char *lit, const u_char *end)
+{
+  u_char *moved;
+  const u_int *a,*b;
+  u_int i;
+  int n,same=1;
+  if((size_t)(end-begin)!=s->size||(size_t)(lit-begin)!=s->lit) return 0;
+  moved=(u_char *)malloc(s->size);
+  assert(moved!=NULL);
+  if(!warm_relocate(s,moved,begin)) { free(moved); return 0; }
+  a=(const u_int *)moved;
+  b=(const u_int *)begin;
+  for(i=0;i<s->lit>>2&&same;i++) {
+    if(a[i]==b[i]) continue;
+    for(n=0;n<s->nlinks;n++)
+      if(s->links[n].jump==i*4) break;
+    if(n<s->nlinks) continue;
+    same=0;
+  }
+  free(moved);
+  return same;
+}
+
+// Flag 2: everything passes 1 to 7 have worked out for the block being compiled, which is all
+// the assembler (pass 8) goes by, into a running hash. Two builds of the recompiler that give
+// the same hash for the same run generate the same code, wherever the libraries are loaded.
+static void warm_hash_analysis(void)
+{
+  uint64_t h=warm_stats.analysis_hash?warm_stats.analysis_hash:0xcbf29ce484222325ull;
+  int i,hr;
+  size_t n;
+  #define WARM_HASH(p,size) { const u_char *bytes=(const u_char *)(p); for(n=0;n<(size_t)(size);n++) { h^=bytes[n]; h*=0x100000001b3ull; } }
+  WARM_HASH(&start,sizeof(start)); WARM_HASH(&slen,sizeof(slen));
+  for(i=0;i<slen;i++) {
+    const int branch=itype[i]==RJUMP||itype[i]==UJUMP||itype[i]==CJUMP||itype[i]==SJUMP||itype[i]==FJUMP;
+    WARM_HASH(&itype[i],1); WARM_HASH(&bt[i],1); WARM_HASH(&likely[i],1); WARM_HASH(&is_ds[i],1); WARM_HASH(&ooo[i],1);
+    WARM_HASH(&rs1[i],1); WARM_HASH(&rs2[i],1); WARM_HASH(&rt1[i],1); WARM_HASH(&rt2[i],1);
+    WARM_HASH(&us1[i],1); WARM_HASH(&us2[i],1); WARM_HASH(&dep1[i],1); WARM_HASH(&dep2[i],1);
+    WARM_HASH(&ccadj[i],sizeof(ccadj[i])); WARM_HASH(&minimum_free_regs[i],1);
+    WARM_HASH(&unneeded_reg[i],8); WARM_HASH(&unneeded_reg_upper[i],8); WARM_HASH(&requires_32bit[i],8);
+    WARM_HASH(&needed_reg[i],sizeof(needed_reg[i]));
+    WARM_HASH(regmap_pre[i],HOST_REGS); WARM_HASH(regs[i].regmap_entry,HOST_REGS); WARM_HASH(regs[i].regmap,HOST_REGS);
+    WARM_HASH(&regs[i].was32,8); WARM_HASH(&regs[i].is32,8); WARM_HASH(&regs[i].wasdirty,8); WARM_HASH(&regs[i].dirty,8);
+    WARM_HASH(&regs[i].wasconst,4); WARM_HASH(&regs[i].isconst,4);
+    for(hr=0;hr<HOST_REGS;hr++)
+      if((regs[i].isconst>>hr)&1) WARM_HASH(&constmap[i][hr],8);
+    if(branch) {
+      WARM_HASH(&ba[i],sizeof(ba[i]));
+      WARM_HASH(branch_regs[i].regmap_entry,HOST_REGS); WARM_HASH(branch_regs[i].regmap,HOST_REGS);
+      WARM_HASH(&branch_regs[i].is32,8); WARM_HASH(&branch_regs[i].dirty,8);
+      WARM_HASH(&branch_regs[i].u,8); WARM_HASH(&branch_regs[i].uu,8);
+      WARM_HASH(&branch_unneeded_reg[i],8); WARM_HASH(&branch_unneeded_reg_upper[i],8);
+    }
+  }
+  #undef WARM_HASH
+  warm_stats.analysis_hash=h;
+}
