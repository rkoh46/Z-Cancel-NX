+/* Z-Cancel NX: the recompiler's warm list (new_dynarec.c, "warm list"). Every block the recompiler
+ * compiles is recorded as three words: its address, the length of its source in bytes and a
+ * checksum of the source words. No game code. A front end keeps the list per ROM:
+ *   DebugDynarecWarmReset()            forget everything (before another ROM)
+ *   DebugDynarecWarmLoad(entries, n)   add a saved list; returns how many entries were new
+ *   DebugDynarecWarmRead(entries, max) copy the list out (loaded and recorded); returns its size
+ *   DebugDynarecPrecompile(budget_us, oversized_us)
+ *                                      on the emulation thread, between two frames: compile listed
+ *                                      blocks whose source is in RAM now, for at most budget_us;
+ *                                      oversized_us > 0: a block that needs more than a whole budget
+ *                                      but not more than this may be compiled, alone in the call.
+ *                                      Returns the number compiled. Changes nothing the game can see.
+ *   DebugDynarecWarmStats(out[16])     counters of the running or the last session (new_dynarec_warm_stats)
+ *   DebugDynarecWarmConfig(flags)      1: verify mode, 2: hash the generated code
+ * All do nothing without the recompiler. */
+EXPORT void CALL DebugDynarecWarmReset(void)
+{
+#ifdef NEW_DYNAREC
+    new_dynarec_warm_reset();
 #endif
 }
 
+EXPORT int CALL DebugDynarecWarmLoad(const unsigned int* entries, int count)
+{
+#ifdef NEW_DYNAREC
+    return entries != NULL && count > 0 ? new_dynarec_warm_load(entries, count) : 0;
+#else
+    return 0;
+#endif
+}
+
+EXPORT int CALL DebugDynarecWarmRead(unsigned int* entries, int max)
+{
+#ifdef NEW_DYNAREC
+    return new_dynarec_warm_read(entries, entries != NULL ? max : 0);
+#else
+    return 0;
+#endif
+}
+
+EXPORT int CALL DebugDynarecPrecompile(unsigned int budget_us, unsigned int oversized_us)
+{
+#ifdef NEW_DYNAREC
+    return g_dev.r4300.emumode == EMUMODE_DYNAREC ? new_dynarec_warm_precompile(budget_us, oversized_us) : 0;
+#else
+    return 0;
+#endif
+}
+
+EXPORT void CALL DebugDynarecWarmStats(unsigned long long* out)
+{
+    memset(out, 0, 16 * sizeof(*out));
+#ifdef NEW_DYNAREC
+    new_dynarec_warm_stats(out);
+#endif
+}
+
+EXPORT void CALL DebugDynarecWarmConfig(int flags)
+{
+#ifdef NEW_DYNAREC
+    new_dynarec_warm_config(flags);
+#endif
+}
